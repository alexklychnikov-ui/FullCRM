# Production stack template for docker-compose.prod.yml
# Copy to .env on the VPS and replace all change_me values.

APP_ENV=production

POSTGRES_DB=fullcrm
POSTGRES_USER=fullcrm
POSTGRES_PASSWORD=change_me_strong_db_password
DATABASE_URL=postgresql+psycopg://fullcrm:change_me_strong_db_password@postgres:5432/fullcrm

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change_me_use_at_least_32_random_characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

OPENAI_API_KEY=
AI_MOCK=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_POLL_COOLDOWN_SECONDS=30

SEED_DEMO=false
# SEED_ADMIN_PASSWORD=

# Public URLs (no trailing slash)
WEB_URL=http://193.168.196.12
API_CORS_ORIGINS=http://193.168.196.12

# Browser uses same-origin /api via nginx; leave empty unless debugging.
NEXT_PUBLIC_API_URL=

# Internal SSR/BFF target is set in compose for web -> http://api:8000
API_URL=http://api:8000

NGINX_HTTP_PORT=80
