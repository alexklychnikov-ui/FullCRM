# Database
POSTGRES_DB=fullcrm
POSTGRES_USER=fullcrm
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fullcrm:change_me@127.0.0.1:5432/fullcrm

# Redis (production stack / future worker)
REDIS_URL=redis://127.0.0.1:6379/0

# Auth
JWT_SECRET=change_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# AI
OPENAI_API_KEY=
AI_MOCK=true
AI_MODEL=gpt-4o-mini
# OPENAI_MODEL is supported as an alias for AI_MODEL

# Telegram (polling MVP; requires both vars for live mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_POLL_COOLDOWN_SECONDS=30

# Demo seed (local/dev only; explicit opt-in required)
SEED_DEMO=false
# SEED_ADMIN_PASSWORD=

# Production bootstrap (one-time; no demo CRM data)
# BOOTSTRAP_ADMIN=false
# BOOTSTRAP_CONFIRM=yes
# BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_TOKEN=

# Application URLs
APP_ENV=local
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production-only (docker-compose.prod.yml)
# NGINX_HTTP_PORT=80